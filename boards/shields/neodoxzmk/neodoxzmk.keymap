#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    /* Unicode via macOS "Unicode Hex Input" layout: hold Option and type the code point */
    macros {
        euro_sign: euro_sign { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N0 &kp A &kp C>, <&macro_release &kp LALT>; };

        /* Lithuanian Macros (lowercase / uppercase) + Auto-Return to Layer 0 */
        lt_a_lo: lt_a_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N0 &kp N5>, <&macro_release &kp LALT>, <&to 0>; };
        lt_a_up: lt_a_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N0 &kp N4>, <&macro_release &kp LALT>, <&to 0>; };
        lt_c_lo: lt_c_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N0 &kp D>, <&macro_release &kp LALT>, <&to 0>; };
        lt_c_up: lt_c_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N0 &kp C>, <&macro_release &kp LALT>, <&to 0>; };
        lt_e_lo: lt_e_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N1 &kp N9>, <&macro_release &kp LALT>, <&to 0>; };
        lt_e_up: lt_e_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N1 &kp N8>, <&macro_release &kp LALT>, <&to 0>; };
        lt_ee_lo: lt_ee_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N1 &kp N7>, <&macro_release &kp LALT>, <&to 0>; };
        lt_ee_up: lt_ee_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N1 &kp N6>, <&macro_release &kp LALT>, <&to 0>; };
        lt_i_lo: lt_i_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N2 &kp F>, <&macro_release &kp LALT>, <&to 0>; };
        lt_i_up: lt_i_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N2 &kp E>, <&macro_release &kp LALT>, <&to 0>; };
        lt_s_lo: lt_s_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N6 &kp N1>, <&macro_release &kp LALT>, <&to 0>; };
        lt_s_up: lt_s_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N6 &kp N0>, <&macro_release &kp LALT>, <&to 0>; };
        lt_u_lo: lt_u_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N7 &kp N3>, <&macro_release &kp LALT>, <&to 0>; };
        lt_u_up: lt_u_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N7 &kp N2>, <&macro_release &kp LALT>, <&to 0>; };
        lt_uu_lo: lt_uu_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N6 &kp B>, <&macro_release &kp LALT>, <&to 0>; };
        lt_uu_up: lt_uu_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N6 &kp A>, <&macro_release &kp LALT>, <&to 0>; };
        lt_z_lo: lt_z_lo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N7 &kp E>, <&macro_release &kp LALT>, <&to 0>; };
        lt_z_up: lt_z_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N1 &kp N7 &kp D>, <&macro_release &kp LALT>, <&to 0>; };
    };

    behaviors {
        /* Lithuanian letters: Shift picks uppercase */
        lt_a: lt_a { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_a_lo>, <&lt_a_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* ą Ą */
        lt_c: lt_c { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_c_lo>, <&lt_c_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* č Č */
        lt_e: lt_e { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_e_lo>, <&lt_e_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* ę Ę */
        lt_ee: lt_ee { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_ee_lo>, <&lt_ee_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* ė Ė */
        lt_i: lt_i { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_i_lo>, <&lt_i_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* į Į */
        lt_s: lt_s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_s_lo>, <&lt_s_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* š Š */
        lt_u: lt_u { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_u_lo>, <&lt_u_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* ų Ų */
        lt_uu: lt_uu { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_uu_lo>, <&lt_uu_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* ū Ū */
        lt_z: lt_z { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&lt_z_lo>, <&lt_z_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };  /* ž Ž */
    };

    keymap {
        compatible = "zmk,keymap";

        /* LAYER 0: DEFAULT */
        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F      &kp P      &kp B                    &kp J          &kp L  &kp U      &kp Y    &kp SEMI  &kp DEL
&kp ESC    &kp A  &kp R  &kp S      &kp T      &kp G                    &kp M          &kp N  &kp E      &kp I    &kp O     &kp LC(LALT)
&kp LSHFT  &kp Z  &kp X  &kp C      &kp D      &kp V                    &kp K          &kp H  &kp COMMA  &kp DOT  &kp FSLH  &mo 1
                         &kp SPACE  &kp LALT   &kp LCTRL                &kp BSPC       &mo 2  &kp ENTER
            >;
        };

        /* LAYER 1: LOWER */
        lower_layer {
            bindings = <
&kp TAB     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                 &kp ASTRK  &kp PLUS   &kp N7  &kp N8  &kp N9  &kp K_CALC
&trans      &kp F6  &kp F7  &kp F8  &kp F9  &kp F10                &kp SLASH  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp DOT
&kp LSHFT   &kp F11 &kp F12 &none   &none   &kp PSCRN              &kp PRCNT  &kp N0     &kp N1  &kp N2  &kp N3  &trans
                            &trans  &trans  &trans                 &trans     &trans     &trans
            >;
        };

        /* LAYER 2: RAISE */
        raise_layer {
            bindings = <
&to 3      &kp EXCL        &kp AT    &kp HASH   &kp DLLR   &kp LBRC      &kp RBRC  &kp MINUS  &kp EQUAL        &kp HOME  &kp END   &kp BSPC
&to 0      &kp PRCNT       &kp AMPS  &kp TILDE  &kp ASTRK  &kp LPAR      &kp RPAR  &kp LEFT   &kp DOWN         &kp UP    &kp RIGHT &kp LS(LG(GRAVE))
&kp LSHFT  &kp UNDERSCORE  &kp CARET &euro_sign &sl 4      &kp LBKT      &kp RBKT  &kp SQT    &kp DQT          &kp GRAVE &kp BSLH  &kp TILDE
                                     &trans     &trans     &trans        &trans    &trans     &trans
            >;
        };

        /* LAYER 3: POWER */
        power_layer {
            bindings = <
&sys_reset  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &kp PSCRN      &none          &none          &none         &none         &none         &none  &none
&to 0        &bt BT_CLR    &none         &none         &none          &none          &out OUT_USB   &out OUT_BLE  &none         &none         &none  &none
&bootloader  &kp LG(L)     &kp K_SLEEP   &none         &none          &none          &none          &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &none  &bootloader
                                        &trans        &trans         &trans         &trans         &trans        &trans
            >;
        };

        /* LAYER 4: LITHUANIAN (Sticky/One-Shot) */
        lithuanian_layer {
            bindings = <
&none      &none     &none     &none     &none     &none          &none     &none     &lt_uu    &lt_u     &none     &kp BSPC
&none      &lt_a     &none     &lt_s     &none     &none          &none     &lt_ee    &lt_e     &lt_i     &none     &none
&kp LSHFT  &lt_z     &none     &lt_c     &none     &none          &none     &none     &none     &none     &none     &none
                               &trans    &trans    &trans         &trans    &trans    &trans
            >;
        };
    };
};
