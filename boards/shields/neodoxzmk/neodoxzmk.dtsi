#include <dt-bindings/zmk/matrix_transform.h>

#include "neodoxzmk-layouts.dtsi"

// Pinout per NeodoxHW v1.1 (both halves wired identically, COL1 = innermost column):
//   ROW1 D3, ROW2 D2, ROW3 D1, ROW4 D0 (thumbs, COL1-COL3 only)
//   COL1 D7, COL2 D8, COL3 D9, COL4 D10, COL5 D6, COL6 NFC2 (P0.10)
//   I2C header: SDA D4, SCL D5, INT1 NFC1 (P0.09)

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
// Left columns 0-5 = COL6..COL1, right columns 6-11 = COL1..COL6
// | SW42 | SW39 | SW36 | SW32 | SW28 | SW24 |   | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |
// | SW43 | SW40 | SW37 | SW33 | SW29 | SW25 |   | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |
// | SW44 | SW41 | SW38 | SW34 | SW30 | SW26 |   | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |
//                      | SW35 | SW31 | SW27 |   | SW19 | SW20 | SW21 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)                 RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};
